# Log every incoming chat message to console.
DEBUG="true"

# OBS browser / overlay (http://127.0.0.1:3847/ by default)
OVERLAY_HOST="127.0.0.1"
OVERLAY_PORT="3847"

# Twitch — auto-enables when TWITCH_CHANNEL is set.
# Username + OAuth token are optional; without them the bot connects read-only.
TWITCH_CHANNEL="headlessheadhunter"
TWITCH_USERNAME=""
TWITCH_OAUTH_TOKEN=""

# YouTube — auto-enables when YOUTUBE_CHANNEL_ID is set.
# With YOUTUBE_API_KEY: uses official Data API v3 (long-poll, costs quota).
# Without API key: falls back to youtubei.js (InnerTube, no quota).
YOUTUBE_CHANNEL_ID="UCPrukg_kzZHzVpvxc424S6A"
YOUTUBE_API_KEY=""
