{
  "name": "headless-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "prestart": "npm run build",
    "dev": "npm run build && node dist/index.mjs",
    "raffle:draw": "node scripts/raffle.mjs draw",
    "raffle:clear": "node scripts/raffle.mjs clear"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "tmi.js": "^1.8.5",
    "youtubei.js": "^17.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/tmi.js": "^1.8.6",
    "tsdown": "^0.21.4",
    "typescript": "^5.7.2"
  }
}
